{
  "permissions": {
    "allow": [
      "Bash(uv run python -m pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run python -m bench.cli:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "python .claude/hooks/protect.py"}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write", "hooks": [{"type": "command", "command": "uv run ruff check --fix --quiet . || true"}]}
    ]
  }
}
